* text=auto

*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

*.gz binary
*.jpg binary
*.jpeg binary
*.png binary
*.pdf binary
*.svg binary
*.whl binary

# Bundled skill resources use byte-level checksums; preserve upstream bytes on checkout.
skills/** -text -eol

# Native backend manifests also verify exact resource bytes after installation.
src/dnakit/databases/_providers/** -text -eol
src/dnakit/encode/_backend/** -text -eol
src/dnakit/workflows/common/** -text -eol
src/dnakit/workflows/prs/** -text -eol
src/dnakit/workflows/support/** -text -eol
