<tool id="dnakit_report" name="DNAKit report" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>build a self-contained DNA sequence report</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements" />
    <command detect_errors="exit_code"><![CDATA[
dnakit report
'$input'
'report.html'
--input-format fasta
--title '$title'
--max-records '$max_records'
--overwrite
> '$audit'
    ]]></command>
    <inputs>
        <param name="input" type="data" format="fasta" label="Input sequences" />
        <param name="title" type="text" value="DNAKit report" label="Report title" />
        <param name="max_records" type="integer" value="1000" min="1" max="100000" label="Maximum records" />
    </inputs>
    <outputs>
        <data name="report" format="html" from_work_dir="report.html" label="${tool.name} on ${on_string}" />
        <data name="audit" format="json" label="${tool.name} audit on ${on_string}" />
    </outputs>
    <tests>
        <test expect_num_outputs="2">
            <param name="input" value="fixed_demo.fasta" ftype="fasta" />
            <param name="title" value="DNAKit Galaxy report" />
            <param name="max_records" value="10" />
            <output name="report" ftype="html">
                <assert_contents>
                    <has_text text="DNAKit Galaxy report" />
                    <has_text text="seq-a" />
                    <has_text text="record_count" />
                </assert_contents>
            </output>
            <output name="audit" ftype="json">
                <assert_contents>
                    <has_text text="&quot;format&quot;: &quot;html&quot;" />
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
Build a bounded, self-contained HTML report from a FASTA dataset. The report
does not load scripts, fonts, or other resources from the network.
    ]]></help>
    <expand macro="citations" />
</tool>
